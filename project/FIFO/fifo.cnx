LICENSE_ID: "FEATURE_STRATIXGX_DPA"	10623205H5360023226I
LICENSE_ID: "FEATURE_STRATIXGX_BASIC"	10623205R5360023226A


SUPPORTED_DEVICE_FAMILY: "Cyclone III"
