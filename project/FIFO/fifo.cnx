VERSION: WM1.0
MODULE: dcfifo
PRIVATE: AlmostEmpty NUMERIC "0"
PRIVATE: AlmostEmptyThr NUMERIC "-1"
PRIVATE: AlmostFull NUMERIC "0"
PRIVATE: AlmostFullThr NUMERIC "-1"
PRIVATE: CLOCKS_ARE_SYNCHRONIZED NUMERIC "0"
PRIVATE: Clock NUMERIC "4"
PRIVATE: Depth NUMERIC "8192"
PRIVATE: Empty NUMERIC "1"
PRIVATE: Full NUMERIC "1"
PRIVATE: INTENDED_DEVICE_FAMILY STRING "Cyclone IV E"
PRIVATE: LE_BasedFIFO NUMERIC "0"
PRIVATE: LegacyRREQ NUMERIC "1"
PRIVATE: MAX_DEPTH_BY_9 NUMERIC "0"
PRIVATE: OVERFLOW_CHECKING NUMERIC "0"
PRIVATE: Optimize NUMERIC "0"
PRIVATE: RAM_BLOCK_TYPE NUMERIC "0"
PRIVATE: SYNTH_WRAPPER_GEN_POSTFIX STRING "0"
PRIVATE: UNDERFLOW_CHECKING NUMERIC "0"
PRIVATE: UsedW NUMERIC "1"
PRIVATE: Width NUMERIC "12"
PRIVATE: dc_aclr NUMERIC "0"
PRIVATE: diff_widths NUMERIC "0"
PRIVATE: msb_usedw NUMERIC "0"
PRIVATE: output_width NUMERIC "12"
PRIVATE: rsEmpty NUMERIC "1"
PRIVATE: rsFull NUMERIC "0"
PRIVATE: rsUsedW NUMERIC "0"
PRIVATE: sc_aclr NUMERIC "0"
PRIVATE: sc_sclr NUMERIC "0"
PRIVATE: wsEmpty NUMERIC "0"
PRIVATE: wsFull NUMERIC "0"
PRIVATE: wsUsedW NUMERIC "0"
LIBRARY: altera_mf altera_mf.altera_mf_components.all
CONSTANT: INTENDED_DEVICE_FAMILY STRING "Cyclone IV E"
CONSTANT: LPM_HINT STRING "MAXIMUM_DEPTH=8192"
CONSTANT: LPM_NUMWORDS NUMERIC "8192"
CONSTANT: LPM_SHOWAHEAD STRING "OFF"
CONSTANT: LPM_TYPE STRING "dcfifo"
CONSTANT: LPM_WIDTH NUMERIC "12"
CONSTANT: LPM_WIDTHU NUMERIC "13"
CONSTANT: OVERFLOW_CHECKING STRING "ON"
CONSTANT: RDSYNC_DELAYPIPE NUMERIC "4"
CONSTANT: UNDERFLOW_CHECKING STRING "ON"
CONSTANT: USE_EAB STRING "ON"
CONSTANT: WRSYNC_DELAYPIPE NUMERIC "4"
USED_PORT: data 0 0 12 0 INPUT NODEFVAL "data[11..0]"
USED_PORT: q 0 0 12 0 OUTPUT NODEFVAL "q[11..0]"
USED_PORT: rdclk 0 0 0 0 INPUT NODEFVAL "rdclk"
USED_PORT: rdempty 0 0 0 0 OUTPUT NODEFVAL "rdempty"
USED_PORT: rdreq 0 0 0 0 INPUT NODEFVAL "rdreq"
USED_PORT: wrclk 0 0 0 0 INPUT NODEFVAL "wrclk"
USED_PORT: wrreq 0 0 0 0 INPUT NODEFVAL "wrreq"
CONNECT: @data 0 0 12 0 data 0 0 12 0
CONNECT: @rdclk 0 0 0 0 rdclk 0 0 0 0
CONNECT: @rdreq 0 0 0 0 rdreq 0 0 0 0
CONNECT: @wrclk 0 0 0 0 wrclk 0 0 0 0
CONNECT: @wrreq 0 0 0 0 wrreq 0 0 0 0
CONNECT: q 0 0 12 0 @q 0 0 12 0
CONNECT: rdempty 0 0 0 0 @rdempty 0 0 0 0
GEN_FILE: TYPE_NORMAL fifo.v TRUE
GEN_FILE: TYPE_NORMAL fifo.inc FALSE
GEN_FILE: TYPE_NORMAL fifo.cmp FALSE
GEN_FILE: TYPE_NORMAL fifo.bsf TRUE
GEN_FILE: TYPE_NORMAL fifo_inst.v FALSE
GEN_FILE: TYPE_NORMAL fifo_bb.v TRUE
LIB_FILE: altera_mf

LICENSE_ID: "DEVICE_FAMILY_Cyclone III"	10623205P5360023226M
LICENSE_ID: "DEVICE_FAMILY_Cyclone II"	10623205T5360023226W
LICENSE_ID: "DEVICE_FAMILY_Cyclone IV E"	10623205A5360023226A
